#!/bin/sh
# Reject commit messages that carry AI-assistant session links. Those
# point at private transcripts and must not end up in a public
# repository. Co-author lines are fine. Runs after prepare-commit-msg,
# before the commit is written.
#
# Enable with: git config core.hooksPath .githooks (make bootstrap does this)

msg_file="$1"

# Ignore comment lines; git strips them before committing.
if grep -v '^#' "$msg_file" | grep -qiE 'claude\.ai/code|^Claude-Session:'; then
  echo "commit-msg: message contains an AI session link; remove it and retry" >&2
  exit 1
fi
